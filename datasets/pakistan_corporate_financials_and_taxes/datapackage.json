  "source_url": "https://www.sbp.org.pk",
  "maintainer": "OpenDoc Data Stewardship Team",
  "geographic_coverage": "Pakistan (National Corporate Sector)",
  "temporal_coverage": "2020-2024",
  "update_frequency": "Annually",
